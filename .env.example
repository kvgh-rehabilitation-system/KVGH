# 複製為 .env 後修改（docker compose 會自動讀取）

# 主機 port（只影響主機側映射；容器內部 port 不變）
FRONTEND_PORT=2000
# 後端直連（遠端開發用：Mac 上 vite dev 的 /api proxy 指到 http://<本機IP>:此port）
BACKEND_PORT=8000
POSTGRES_HOST_PORT=15432
# 5672 發布到主機，未來遠端 GPU server 的 worker 也連這裡
RABBITMQ_HOST_PORT=5672
# 管理介面（僅綁 127.0.0.1）
RABBITMQ_MGMT_PORT=15672

# PostgreSQL
POSTGRES_USER=kvgh
POSTGRES_PASSWORD=change-me-pg
POSTGRES_DB=kvgh

# RabbitMQ（5672 發布到主機，未來遠端 GPU server 也連這裡）
RABBITMQ_USER=kvgh
RABBITMQ_PASS=change-me-mq

# GPU 資源保護
# 同時執行的 GPU 任務上限（RTX 2080 8GB 實測上限 2；換大 VRAM server 時調高）
GPU_MAX_CONCURRENCY=2
# GPU 任務啟動前要求的最低剩餘 VRAM（MB），不足則延後重試，防止 OOM
GPU_MIN_FREE_VRAM_MB=3000

# 演算法引擎位置（AlphaPose/MotionBERT 工作目錄：程式碼與 .so 進 git）
# 大權重（~1.5GB）不進 git：首次 docker compose up 由 weights-init 服務
# 從 GitHub Release weights-v1 自動下載到此目錄（scripts/download_weights.sh）
ENGINE_DIR=./algorithm/2D_and_3D_project
